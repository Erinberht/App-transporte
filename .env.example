# Copia este archivo como .env.local y completa los valores. No subas .env.local al repositorio.

# Clave de Google Maps SDK for Android (restringida al paquete de la app y su SHA-1).
# Solo se necesita para builds de Android; Expo Go y iOS (Apple Maps) funcionan sin ella.
GOOGLE_MAPS_ANDROID_API_KEY=

# Backend Supabase (opcional). Sin estas dos variables la app funciona sin backend, con las
# rutas incluidas. Ver docs/BACKEND.md. La publishable key es pública (va dentro de la app);
# la secret key NUNCA va aquí.
#   Local: URL http://<IP-del-PC>:54321 y PUBLISHABLE_KEY de `npx supabase status`.
#   Nube:  Settings → API Keys del proyecto en supabase.com.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
