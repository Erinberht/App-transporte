{
  "name": "unicordoba-bus",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.0",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.0",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.0",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:integration": "jest --config jest.integration.config.js",
    "data:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-routes.ts",
    "data:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-routes.ts data/seed --kind seed && npm run -s data:sql",
    "data:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dataset-to-sql.ts",
    "qr:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-qr.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --schema public > src/api/database.types.ts && prettier --write src/api/database.types.ts",
    "db:test": "supabase test db"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native|standard-navigation)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".integration.test.ts$"
    ]
  },
  "private": true
}
